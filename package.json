{
  "name": "@rjames86/homebridge-opensprinkler",
  "displayName": "OpenSprinkler",
  "type": "module",
  "version": "0.1.3",
  "description": "Homebridge plugin for OpenSprinkler irrigation controllers using HomeKit's native Irrigation System service, with MQTT-driven real-time updates.",
  "author": "Ryan James",
  "license": "Apache-2.0",
  "homepage": "https://github.com/rjames86/homebridge-opensprinkler#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjames86/homebridge-opensprinkler.git"
  },
  "bugs": {
    "url": "https://github.com/rjames86/homebridge-opensprinkler/issues"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "opensprinkler",
    "irrigation",
    "sprinkler"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "homebridge": "^2.4.0",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
